{
  "name": "qrhaven",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Simple, editable dynamic QR codes backed by Cloudflare Workers and D1",
  "scripts": {
    "build": "vite build",
    "dev": "npm run build && wrangler dev",
    "db:local": "wrangler d1 migrations apply qrhaven --local",
    "db:remote": "wrangler d1 migrations apply qrhaven --remote",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": { "node": ">=20.19.0" },
  "dependencies": { "qrcode": "^1.5.4" },
  "devDependencies": { "vite": "^7.1.0", "wrangler": "^4.45.0" }
}
