{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qrhaven",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "ratelimits": [{ "name": "CREATE_LIMITER", "namespace_id": "20261020", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    "FRONTEND_BASE_URL": "https://babycrttv.github.io/QRHaven/",
    "CORS_ALLOWED_ORIGIN": "https://babycrttv.github.io"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qrhaven",
      "database_id": "7355624c-f3a1-4092-85ba-512d43cfe04b",
      "migrations_dir": "migrations"
    }
  ]
}
